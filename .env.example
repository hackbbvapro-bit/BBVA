# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local al repositorio.
# En Vercel, las mismas variables van en Project → Settings → Environment Variables.

# --- Agente (Anthropic) ---
ANTHROPIC_API_KEY=
# Opcional. Por defecto: claude-opus-5-5
ANTHROPIC_MODEL=

# --- Voz (Fish Audio) ---
FISH_API_KEY=
# Id de la voz elegida en fish.audio (el final de la dirección fish.audio/m/<id>). Vacío = voz por defecto.
FISH_VOICE_ID=
# Opcional. Por defecto: s2.1-pro  (el gratuito es s2.1-pro-free)
FISH_MODEL=

# --- Notificaciones al celular (web push) ---
# Se generan con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Un correo o una web de contacto del equipo (lo exige el estándar). Ej.: mailto:equipo@ejemplo.com
VAPID_SUBJECT=

# --- Lectura de archivos con IA (apagada por defecto) ---
# Con 1, el botón «Subir un documento» deja elegir una foto o un PDF y lo lee la IA de Anthropic.
# Solo para documentos INVENTADOS: la persona debe declararlo y el servidor rechaza los que no lo declaran.
# Vacío o ausente: solo funciona el reporte de ejemplo, que ya viene leído y no sale del equipo.
LECTURA_DOCUMENTOS=

# --- Opcional, no se usa en la demo ---
# RESEND_API_KEY=
